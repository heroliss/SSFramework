# =====================================================
# Unity 自动生成目录（锚定到项目根，避免误伤 Assets/ 下同名目录）
# =====================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# 内存快照与录制（Profiler/Recorder 输出，根目录）
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Burst 编译缓存（首次启动会重建）
/[Bb]urst[Dd]ebug[Ii]nformation_DoNotShip/

# 自动生成的代码资源（GeneratedAssets 由项目工具链产出，可重建）
/GeneratedAssets/

# 资源构建产物（全收在 AssetBuild/：Bundles 原始产物 / Deploy 平铺发布 / Downloaded 下载缓存），可重建
/AssetBuild/

# YooAsset 原生窗口/默认设置的构建输出落点（框架管线已改输出到 AssetBuild/Bundles；这个根目录是走原生默认路径时留下的散产物），可重建
/[Bb]undles/

# Host 模式内置首包输出（构建时按 profile 首包策略拷进 StreamingAssets 的内置清单，属构建产物、可重建）
/Assets/StreamingAssets/yoo/
/Assets/StreamingAssets/yoo.meta

# Luban codegen 工具 DLL（构建期工具，临时置于根目录，最终位置待定——见 docs/adr/0009）。
# 暂不入库；确定归属（如 Tools/Luban）后再决定跟踪策略。需强制跟踪用 git add -f。
/Luban/

# MCP For Unity 截屏目录（AI 生成的临时截图，不入库）。
/[Ss]creenshots/

# HybridCLR Installer 按机器生成的本地数据（il2cpp_plus 魔改源码 + 仓库克隆，数百 MB~GB 级），
# 每台开发机/CI 各自跑一次 HybridCLR → Installer 重建，不入库。
/HybridCLRData/

# 热更 DLL 中转目录（FrameworkHotUpdateBuilder 每次构建全量重建：热更 DLL/.bytes + AOT 补元数据 + 清单），构建产物不入库。
/Assets/HotUpdateDlls/
/Assets/HotUpdateDlls.meta

# Addressables 自动生成产物（切到 Addressables 时手动启用）
# /[Aa]ssets/[Ss]treamingAssets/aa.meta
# /[Aa]ssets/[Ss]treamingAssets/aa/*
# /[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# =====================================================
# IDE / 编辑器（每个开发者环境不同，不应入库；均锚定到项目根）
# =====================================================
# Visual Studio
/.vs/
/.vsconfig

# JetBrains Rider / IntelliJ
/.idea/
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# VS Code —— 共享配置入库，仅忽略本地状态
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Trae IDE
/.trae/

# Claude Code —— 团队共享配置入库，本地运行时数据忽略
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/agents/
!.claude/hooks/
!.claude/commands/

# C# 工程/解决方案（Unity 自动重新生成，锚定根以保护 Package 内的真实工程）
/*.csproj
/*.sln
/*.slnx
/*.unityproj

# =====================================================
# 操作系统生成文件（可出现在任意目录，不锚定）
# =====================================================
# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
/$RECYCLE.BIN/

# =====================================================
# 平台构建工具缓存
# =====================================================
# Gradle（Android 构建缓存）
/.gradle/

# 导出的工程目录（Android Studio / Xcode）
/ExportedObj/

# =====================================================
# 平台构建产物（开始出包时手动启用）
# =====================================================
# Android
# *.apk
# *.aab
# *.apks
# *.keystore
# *.jks

# iOS
# *.ipa
# *.dSYM
# *.dSYM.zip

# 通用可执行包体
# *.app
# *.exe

# Unity 崩溃报告与 Crashlytics 标识
# sysinfo.txt
# crashlytics-build.properties
