/* Outpost 全部 Toolkit 窗口共用的主题样式。
   uxml 内经 <Style src="Outpost.uss"/> 引用（backend 只 clone uxml、不单独挂 uss——引用随 clone 生效）。
   色板：警戒橙 #FF9E40 为主题色，深空蓝灰为底。 */

/* ── 全屏页（标题 / 结算） ─────────────────────────────── */

.op-page {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    justify-content: center;
    align-items: center;
}

.op-page--title { background-color: rgb(18, 26, 36); }
.op-page--result { background-color: rgb(18, 28, 20); }

.op-title {
    -unity-font-style: bold;
    font-size: 34px;
    color: rgb(255, 158, 64);
    letter-spacing: 4px;
    margin-bottom: 18px;
}

.op-label {
    color: rgb(217, 224, 242);
    font-size: 14px;
    margin-bottom: 10px;
}

/* 次要信息（历史战绩等）——比正文更收敛的灰蓝 */
.op-label--dim { color: rgb(166, 184, 204); }

/* 结算判定行（主动撤离 / 哨站失守），颜色由代码按结局设置 */
.op-verdict { font-size: 22px; }

.op-btn {
    margin-top: 8px;
    min-width: 220px;
    height: 36px;
    font-size: 14px;
}

/* ── 模态卡片（框架看点弹窗） ──────────────────────────── */

/* 卡片外层定位容器：铺满并居中卡片；picking-mode 在 uxml 上设为 Ignore（点击透传给遮罩/下层） */
.op-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    justify-content: center;
    align-items: center;
}

.op-card {
    /* 用确定宽度而非 max-width：收缩容器里的换行 Label 会先按无界宽度测高（单行）、
       再被 max-width 钳住换行——父容器高度不随之重算，条目互相压叠。定宽让首轮测量即约束。 */
    width: 520px;
    padding: 14px 20px;
    background-color: rgba(26, 33, 43, 0.98);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(255, 158, 64);
}

.op-card__title {
    -unity-font-style: bold;
    font-size: 18px;
    color: rgb(255, 158, 64);
    margin-bottom: 10px;
}

/* 一条「看点」= 单个富文本 Label（橙色小标题行 + 灰色说明行，颜色/字号走 rich text 标签）。
   刻意不做「标题 Label + 说明 Label 套容器」的嵌套：容器高度按子元素首轮（未换行）测量结果结算、
   说明换行后不回填父高，条目会互相压叠——单 Label 自测自高没有这层不同步。 */
.op-bullet {
    font-size: 11px;
    color: rgb(184, 196, 217);
    white-space: normal;
    margin-bottom: 7px;
}

/* 脚注小灰字（指向文档路径等） */
.op-hint {
    color: rgb(140, 153, 173);
    font-size: 10px;
    margin-top: 4px;
    white-space: normal;
}

/* 卡片内按钮比全屏页按钮矮一档 */
.op-card .op-btn {
    height: 30px;
    margin-top: 6px;
}

/* ── 设置弹窗 ─────────────────────────────────────────── */

.op-card--settings { width: 380px; }

.op-slider {
    margin: 6px 0;
    color: rgb(217, 224, 242);
}

/* 语言选择行：标签 + 两个语言按钮并排 */
.op-lang-row {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.op-lang-row__label { margin-bottom: 0; margin-right: 12px; }

.op-btn--lang {
    min-width: 96px;
    margin-top: 0;
    margin-right: 8px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

/* 当前语言的按钮描边高亮（代码按 Locale 切换该类；后端选择行复用同一套类） */
.op-btn--lang-active { border-color: rgb(255, 158, 64); }

/* 设置项下的小字提示（如后端切换「下一局生效」） */
.op-settings__hint {
    font-size: 11px;
    color: rgb(140, 150, 178);
    margin-top: 2px;
    white-space: normal;
}

/* 扩展内容区（增援电台）：浅色顶边与滑条区分隔 */
.op-expansion {
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(120, 132, 165, 0.35);
}

.op-expansion__head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.op-expansion__name { margin-bottom: 0; }

/* 状态短语（已启用 / 失败）：随代码换 key，绿色系表示"装好了" */
.op-expansion__status { margin-bottom: 0; color: rgb(140, 214, 160); }

.op-expansion__desc {
    font-size: 11px;
    color: rgb(140, 150, 178);
    margin-top: 2px;
    white-space: normal;
}

/* 下载进度条：容器暗槽 + 橙色填充（宽度百分比由代码驱动） */
.op-progress {
    height: 6px;
    margin-top: 8px;
    background-color: rgba(20, 26, 44, 0.9);
    border-radius: 3px;
}

.op-progress__fill {
    height: 100%;
    width: 0;
    background-color: rgb(255, 158, 64);
    border-radius: 3px;
}

/* ── 排行榜弹窗 ───────────────────────────────────────── */

.op-card--leaderboard { width: 430px; }

.op-lb-list { margin-top: 2px; margin-bottom: 8px; }

/* 一行 = 名次 | 署名(撑满) | 波次 | 分数，行视图由 BindList 工厂代码构建 */
.op-lb-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    border-radius: 4px;
}

.op-lb-row__rank {
    width: 30px;
    -unity-font-style: bold;
    font-size: 13px;
    color: rgb(255, 158, 64);
}

.op-lb-row__name {
    flex-grow: 1;
    font-size: 13px;
    color: rgb(217, 224, 242);
}

.op-lb-row__wave {
    width: 70px;
    font-size: 12px;
    color: rgb(166, 184, 204);
    -unity-text-align: middle-right;
}

.op-lb-row__score {
    width: 84px;
    font-size: 13px;
    color: rgb(217, 224, 242);
    -unity-text-align: middle-right;
}

/* 自己的署名行（存档 Callsign 匹配时代码加此类） */
.op-lb-row--self { background-color: rgba(255, 158, 64, 0.14); }
.op-lb-row--self .op-lb-row__name { color: rgb(255, 158, 64); }

/* 底部操作行：刷新 / 关闭并排 */
.op-lb-actions {
    flex-direction: row;
    justify-content: space-between;
}

.op-btn--half { min-width: 0; width: 48%; }

/* 结算页的全服名次行（有名次才显示，颜色随"上榜"语气走主题橙） */
.op-rank { color: rgb(255, 158, 64); }
