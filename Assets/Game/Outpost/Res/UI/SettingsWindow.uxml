<?xml version="1.0" encoding="utf-8"?>
<!-- 设置弹窗布局：音量三滑条（直连 IAudioUtility，即时生效）+ 语言切换（直调 SetLocale，下层标题页文案实时跟变）。
     语言按钮文案是语言自称（中文 / English），刻意不本地化。其余文案运行时绑 key，uxml 中文只是设计期占位。 -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Outpost.uss" />
    <ui:VisualElement class="op-overlay" picking-mode="Ignore">
        <ui:VisualElement class="op-card op-card--settings">
            <ui:Label name="title" text="设置" class="op-card__title" enable-rich-text="false" />
            <ui:Slider name="master" label="主音量" low-value="0" high-value="1" class="op-slider" />
            <ui:Slider name="music" label="音乐" low-value="0" high-value="1" class="op-slider" />
            <ui:Slider name="sfx" label="音效" low-value="0" high-value="1" class="op-slider" />
            <ui:VisualElement class="op-lang-row">
                <ui:Label name="lang-label" text="语言" class="op-label op-lang-row__label" enable-rich-text="false" />
                <ui:Button name="lang-zh" text="中文" class="op-btn op-btn--lang" />
                <ui:Button name="lang-en" text="English" class="op-btn op-btn--lang" />
            </ui:VisualElement>
            <!-- 战斗模拟后端（ADR-0030 双后端）：按钮文案是技术名词不本地化；改动写 BattlePrefsModel、下一局生效。 -->
            <ui:VisualElement class="op-lang-row">
                <ui:Label name="backend-label" text="战斗后端" class="op-label op-lang-row__label" enable-rich-text="false" />
                <ui:Button name="backend-ecs" text="DOTS·ECS" class="op-btn op-btn--lang" />
                <ui:Button name="backend-ref" text="OOP" class="op-btn op-btn--lang" />
            </ui:VisualElement>
            <ui:Label name="backend-hint" text="下一局生效" class="op-settings__hint" enable-rich-text="false" />
            <!-- 扩展内容区（OutpostExpansionPackage）：不自动初始化的第二资源包，显式下载器带进度（DLC 姿势）。 -->
            <ui:VisualElement class="op-expansion">
                <ui:VisualElement class="op-expansion__head">
                    <ui:Label name="exp-name" text="增援电台" class="op-label op-expansion__name" enable-rich-text="false" />
                    <ui:Label name="exp-status" text="" class="op-label op-expansion__status" enable-rich-text="false" />
                </ui:VisualElement>
                <ui:Label name="exp-desc" text="扩展内容" class="op-expansion__desc" enable-rich-text="false" />
                <ui:VisualElement name="exp-bar" class="op-progress">
                    <ui:VisualElement name="exp-fill" class="op-progress__fill" />
                </ui:VisualElement>
                <ui:Button name="exp-download" text="下载" class="op-btn" />
                <!-- 电台战斗曲开关：仅扩展包已安装时显示（代码控制显隐）；写 BattlePrefsModel、即时换曲。 -->
                <ui:VisualElement name="exp-bgm-row" class="op-lang-row">
                    <ui:Label name="exp-bgm-label" text="电台战斗曲" class="op-label op-lang-row__label" enable-rich-text="false" />
                    <ui:Button name="exp-bgm-on" text="开" class="op-btn op-btn--lang" />
                    <ui:Button name="exp-bgm-off" text="关" class="op-btn op-btn--lang" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="close" text="关闭" class="op-btn" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
