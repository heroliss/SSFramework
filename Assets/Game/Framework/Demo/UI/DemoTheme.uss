/* ============================================================
   SSFramework Demo —— 整体样式主题（暗色 · 简约）
   风格与内容解耦：模块只挂 class，不写内联样式；换肤只改这一份。
   配色承担稳定语义：蓝 = 导航 / 普通动作，青绿 = 重点速记，黄 = 注意边界，橙 = 教学实验。
   颜色始终配合文字标签、边框和卡片结构，不作为唯一识别线索。
   ============================================================ */

.demo-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(24, 25, 30);
}

/* 顶部标题条 */
.demo-app-title {
    height: 50px;
    -unity-text-align: middle-left;
    padding-left: 22px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(236, 238, 243);
    background-color: rgb(32, 34, 41);
    border-bottom-width: 1px;
    border-bottom-color: rgb(44, 47, 55);
}

/* 主体：左导航 + 右内容 */
.demo-body {
    flex-grow: 1;
    flex-direction: row;
}

/* ---- 左侧导航 ---- */
.demo-nav {
    width: 270px;
    background-color: rgb(30, 32, 38);
    border-right-width: 1px;
    border-right-color: rgb(44, 47, 55);
    padding-top: 6px;
    padding-bottom: 12px;
}

.demo-nav-category {
    margin-top: 16px;
    margin-bottom: 4px;
    padding-left: 18px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(120, 126, 138);
    letter-spacing: 1px;
}

.demo-nav-item {
    min-height: 36px;
    height: auto;
    margin: 1px 8px;
    padding: 6px 12px;
    -unity-text-align: middle-left;
    white-space: normal;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 7px;
    color: rgb(190, 195, 205);
    font-size: 13px;
    transition-duration: 0.08s;
}

.demo-nav-item:hover {
    background-color: rgb(40, 43, 51);
    color: rgb(220, 224, 232);
}

.demo-nav-item--active {
    background-color: rgb(36, 48, 70);
    color: rgb(120, 178, 255);
    -unity-font-style: bold;
}

/* 规划中的章节：导航项弱化显示 */
.demo-nav-item--soon {
    color: rgb(110, 115, 126);
}

/* ---- 右侧内容 ---- */
.demo-content {
    flex-grow: 1;
    padding: 28px 34px;
}

/* 标题 / 简介 / 正文统一限宽：宽屏下不让一行文字铺满全屏（长行难扫读），左对齐贴导航。 */
.demo-content-progress {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(105, 145, 205);
    letter-spacing: 0.6px;
    margin-bottom: 5px;
    max-width: 960px;
}

.demo-content-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(236, 238, 243);
    margin-bottom: 6px;
    max-width: 960px;
}

.demo-content-summary {
    font-size: 13px;
    color: rgb(178, 184, 196);
    margin-bottom: 14px;
    padding: 10px 13px;
    white-space: normal;
    max-width: 960px;
    background-color: rgb(30, 32, 38);
    border-left-width: 3px;
    border-left-color: rgb(72, 92, 126);
    border-radius: 6px;
}

.demo-content-body {
    flex-grow: 1;
    max-width: 960px;
}

/* 窄屏不再硬挤“270px 左栏 + 正文”：导航移到上方成为有限高度的可滚动目录，正文拿回整行宽度。 */
.demo-root--narrow .demo-body {
    flex-direction: column;
}

.demo-root--narrow .demo-nav {
    width: auto;
    height: 168px;
    flex-shrink: 0;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(44, 47, 55);
}

.demo-root--narrow .demo-content {
    padding: 18px 14px;
}

.demo-root--narrow .demo-app-title {
    padding-left: 14px;
}

/* 章节底部的线性学习导航：入门/核心提示顺读，能力/进阶保留自由挑选。 */
.demo-chapter-navigation {
    max-width: 960px;
    flex-direction: row;
    align-items: center;
    margin-top: 26px;
    padding-top: 14px;
    padding-bottom: 8px;
    border-top-width: 1px;
    border-top-color: rgb(44, 47, 55);
}

.demo-chapter-navigation-button {
    min-width: 150px;
    max-width: 280px;
    min-height: 32px;
    padding: 5px 12px;
    white-space: normal;
    background-color: rgb(38, 41, 49);
    color: rgb(150, 178, 230);
    border-width: 1px;
    border-color: rgb(55, 60, 72);
    border-radius: 6px;
    font-size: 11px;
    transition-duration: 0.08s;
}

.demo-chapter-navigation-button:hover {
    background-color: rgb(36, 48, 70);
    color: rgb(120, 178, 255);
    border-color: rgb(96, 165, 250);
}

.demo-chapter-navigation-button:disabled {
    opacity: 0.38;
}

.demo-chapter-navigation-hint {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 0 12px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(120, 126, 138);
    font-size: 10px;
}

/* ---- 模块内容元素 ---- */
.demo-section-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(205, 216, 232);
    margin-top: 20px;
    margin-bottom: 9px;
    padding: 6px 9px;
    background-color: rgb(29, 33, 41);
    border-left-width: 3px;
    border-left-color: rgb(72, 101, 145);
    border-radius: 5px;
    white-space: normal;
    flex-shrink: 1;
}

/* 章首定位是独立语义，不再与普通小节标题同形。 */
.demo-positioning {
    margin-top: 0;
    margin-bottom: 13px;
    padding: 10px 13px;
    background-color: rgb(33, 43, 58);
    color: rgb(151, 198, 255);
    border-width: 1px;
    border-color: rgb(61, 88, 127);
    border-left-width: 4px;
    border-left-color: rgb(92, 154, 235);
    border-radius: 7px;
    font-size: 13px;
}

.demo-note {
    font-size: 13px;
    color: rgb(196, 201, 211);
    margin-bottom: 7px;
    white-space: normal;
}

/* 讲解段落 + 行末源码链接：横排，链接顶对齐贴在文字右侧；放不下时链接整体折到下一行而不是溢出右侧 */
.demo-note-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

/* 对比表格：表头 + 数据行，等宽列、单元格换行，用于并排对比多项 */
.demo-table {
    margin-top: 6px;
    margin-bottom: 12px;
    border-width: 1px;
    border-color: rgb(55, 60, 72);
    border-radius: 6px;
    overflow: hidden;
}

.demo-table-row {
    flex-direction: row;
    align-items: stretch;
    border-bottom-width: 1px;
    border-bottom-color: rgb(44, 47, 55);
}

.demo-table-row--head {
    background-color: rgb(36, 48, 70);
}

.demo-table-cell {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    padding: 7px 10px;
    white-space: normal;
    font-size: 12px;
    color: rgb(190, 195, 205);
    border-left-width: 1px;
    border-left-color: rgb(44, 47, 55);
}

.demo-table-cell--head {
    -unity-font-style: bold;
    color: rgb(150, 178, 230);
}

/* 手把手步骤：左侧序号徽标 + 右侧步骤说明，把一串操作变成可顺序扫读的有序流程 */
.demo-step {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    margin-top: 9px;
    margin-bottom: 3px;
}

.demo-step-badge {
    flex-shrink: 0;
    min-width: 24px;
    height: 22px;
    margin-right: 10px;
    padding: 0 6px;
    -unity-text-align: middle-center;
    background-color: rgb(36, 48, 70);
    color: rgb(120, 178, 255);
    border-radius: 6px;
    font-size: 13px;
    -unity-font-style: bold;
}

.demo-step-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: rgb(206, 211, 221); /* 比普通 note 略亮：步骤是主干内容 */
    font-size: 13px;
}

/* 次级细节（原理 / 补充）：缩进作为某条主干下的“展开看”内容，与正文拉开层级；
   字号与正文一致、颜色仅略暗（靠缩进而非缩字号区分层级，避免太小读不清） */
.demo-subnote {
    font-size: 13px;
    color: rgb(165, 172, 188);
    margin-left: 34px; /* 与 step 文字大致对齐（徽标 min-width 24 + margin 10） */
    margin-bottom: 6px;
    white-space: normal;
}

.demo-callout {
    border-width: 1px;
    border-left-width: 3px;
    border-radius: 6px;
    padding: 9px 12px;
    margin-top: 10px;
    margin-bottom: 8px;
}

.demo-callout-title {
    margin-bottom: 4px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.demo-callout-body {
    font-size: 12px;
    white-space: normal;
}

/* Tip 只表示速记 / 心智模型，不再与风险实验共用黄色。 */
.demo-tip {
    background-color: rgba(35, 110, 101, 0.18);
    border-color: rgba(76, 179, 163, 0.35);
    border-left-color: rgb(76, 179, 163);
}

.demo-tip .demo-callout-title {
    color: rgb(122, 218, 201);
}

.demo-tip .demo-callout-body {
    color: rgb(190, 211, 207);
}

/* Caution 是非实验型错误边界：需要注意，但不会因为这张卡本身执行任何动作。 */
.demo-caution {
    background-color: rgba(122, 91, 29, 0.20);
    border-color: rgba(222, 171, 67, 0.38);
    border-left-color: rgb(222, 171, 67);
}

.demo-caution .demo-callout-title {
    color: rgb(245, 205, 130);
}

.demo-caution .demo-callout-body {
    color: rgb(214, 207, 193);
}

/* 教学实验：任何故意失败或有副作用的动作，都先给出影响、证据与恢复闭环。 */
.demo-experiment {
    margin-top: 9px;
    margin-bottom: 10px;
    padding: 10px 13px;
    background-color: rgba(129, 61, 24, 0.22);
    border-width: 1px;
    border-color: rgba(234, 132, 69, 0.45);
    border-left-width: 3px;
    border-left-color: rgb(234, 132, 69);
    border-radius: 6px;
}

.demo-experiment-title-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 5px;
}

.demo-experiment-title {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: rgb(255, 177, 116);
    -unity-font-style: bold;
    font-size: 13px;
}

.demo-experiment-row {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 3px;
}

.demo-experiment-term {
    width: 76px;
    min-width: 76px;
    flex-shrink: 0;
    white-space: normal;
    color: rgb(240, 159, 99);
    -unity-font-style: bold;
    font-size: 12px;
}

.demo-experiment-desc {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: rgb(215, 202, 194);
    font-size: 12px;
}

/* 极窄正文里术语与解释上下排，避免固定术语列把说明压成逐字换行。 */
.demo-root--narrow .demo-experiment-row {
    flex-direction: column;
}

.demo-root--narrow .demo-experiment-term {
    width: auto;
    min-width: 0;
    margin-bottom: 1px;
}

.demo-root--narrow .demo-concept {
    flex-direction: column;
}

.demo-root--narrow .demo-concept-heading {
    width: auto;
    margin-right: 0;
    margin-bottom: 6px;
}

.demo-root--narrow .demo-chapter-navigation {
    flex-direction: column;
    align-items: stretch;
}

.demo-root--narrow .demo-chapter-navigation-button {
    width: 100%;
    min-width: 0;
    max-width: 100%;
}

.demo-root--narrow .demo-chapter-navigation-hint {
    width: auto;
    margin-top: 6px;
    margin-bottom: 6px;
}

.demo-value {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(236, 238, 243);
    margin-bottom: 12px;
    white-space: normal;   /* 长状态文本在容器内换行，不再横向溢出屏幕 */
    flex-shrink: 1;        /* 处在 demo-value-row（flex 行）里时也能收缩换行，而非把行撑宽 */
}

/* 值显示 + 行末源码跳转：把“看到的状态”和“喂它的查询 Command”并排 */
.demo-value-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

/* 概念条目：术语 + 说明 的定义列表行（讲解分层职责 / 概念释义） */
.demo-concept {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start; /* 术语换行/说明多行时都从顶部对齐 */
    margin-bottom: 8px;
    padding: 10px 12px;
    background-color: rgb(32, 35, 42);
    border-width: 1px;
    border-color: rgb(48, 53, 64);
    border-left-width: 3px;
    border-left-color: rgb(69, 97, 140);
    border-radius: 7px;
}

.demo-concept-heading {
    width: 164px;
    flex-shrink: 0;
    margin-right: 14px;
}

.demo-concept-kind {
    align-self: flex-start;
    margin-bottom: 4px;
    padding: 2px 6px;
    background-color: rgba(64, 104, 166, 0.28);
    color: rgb(129, 183, 248);
    border-radius: 4px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
}

.demo-concept-term {
    white-space: normal; /* 长术语在列内换行，不再溢出列宽压到右侧说明上 */
    -unity-font-style: bold;
    color: rgb(160, 194, 236);
    font-size: 13px;
}

.demo-concept-desc {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: rgb(196, 201, 211);
    font-size: 13px;
}

/* 当前环境不可用是独立状态，不再伪装成普通概念页。 */
.demo-unavailable {
    margin-top: 2px;
    padding: 4px 12px 10px 12px;
    background-color: rgba(112, 55, 55, 0.16);
    border-width: 1px;
    border-color: rgba(205, 105, 105, 0.38);
    border-left-width: 4px;
    border-left-color: rgb(205, 105, 105);
    border-radius: 8px;
}

.demo-unavailable-title {
    background-color: rgba(118, 54, 54, 0.18);
    border-left-color: rgb(205, 105, 105);
    color: rgb(242, 168, 168);
}

.demo-concept--unavailable {
    background-color: rgba(58, 39, 42, 0.55);
    border-color: rgba(123, 75, 80, 0.48);
    border-left-color: rgb(150, 86, 92);
}

.demo-concept--unavailable .demo-concept-kind {
    background-color: rgba(139, 73, 80, 0.32);
    color: rgb(235, 157, 164);
}

/* 对象池章：左侧控制按钮 + 右侧 UI Toolkit 占位框（UGUI 容器按该框 worldBound 对齐） */
.demo-pool-demo-row {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 4px;
    margin-bottom: 10px;
}

.demo-pool-controls {
    width: 400px; /* 容下最宽的「动作按钮 + 行末查看源码」整行，不让链接溢出压到右侧方块容器上 */
    flex-shrink: 0;
    margin-right: 22px;
}

.demo-pool-anchor {
    flex-grow: 1;
    min-height: 210px;
    background-color: rgba(38, 41, 49, 0.55);
    border-width: 1px;
    border-color: rgb(55, 60, 72);
    border-radius: 6px;
}

/* 动作行：演示按钮 + 紧挨着的源码跳转；放不下时源码链接折到下一行而不是被挤出窗口右侧 */
.demo-action-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 7px;
}

.demo-btn {
    height: 33px;
    min-width: 90px;
    padding: 0 18px;
    background-color: rgb(59, 130, 246);
    color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 7px;
    font-size: 13px;
    -unity-font-style: bold;
    transition-duration: 0.08s;
}

.demo-root--narrow .demo-btn {
    width: 100%;
    max-width: 100%;
    height: auto;
    min-height: 33px;
    padding: 7px 12px;
    white-space: normal;
}

.demo-root--narrow .demo-action-row {
    align-items: stretch;
}

.demo-root--narrow .demo-pool-demo-row {
    flex-direction: column;
}

.demo-root--narrow .demo-pool-controls {
    width: auto;
    margin-right: 0;
}

.demo-root--narrow .demo-pool-anchor {
    width: 100%;
}

.demo-btn:hover {
    background-color: rgb(37, 99, 235);
}

.demo-btn:active {
    background-color: rgb(29, 78, 216);
}

.demo-btn--experiment {
    background-color: rgb(174, 82, 37);
    border-width: 1px;
    border-color: rgb(234, 132, 69);
}

.demo-btn--experiment:hover {
    background-color: rgb(202, 98, 43);
}

.demo-btn--experiment:active {
    background-color: rgb(145, 65, 31);
}

/* 源码跳转：低调的次级按钮，紧挨动作按钮 */
.demo-code-link {
    min-height: 27px;
    margin-left: 9px;
    padding: 4px 11px;
    background-color: rgb(38, 41, 49);
    color: rgb(150, 168, 198);
    border-width: 1px;
    border-color: rgb(55, 60, 72);
    border-radius: 6px;
    font-size: 11px;
    -unity-font-style: normal;
    white-space: normal;   /* 标签很长时按钮内文字也能换行，配合行级 flex-wrap 双重兜底 */
    flex-shrink: 1;
    transition-duration: 0.08s;
}

.demo-code-link:hover {
    background-color: rgb(36, 48, 70);
    color: rgb(120, 178, 255);
    border-color: rgb(96, 165, 250);
}

/* ---- 下载进度条（默认轨道+填充都偏白，看不出进度；改成暗色轨道 + 蓝色填充 + 可读标题）---- */
.unity-progress-bar {
    margin-top: 2px;
    margin-bottom: 8px;
}

.unity-progress-bar__background {
    background-color: rgb(38, 41, 49);
    border-width: 1px;
    border-color: rgb(55, 60, 72);
    border-radius: 6px;
    min-height: 22px;
}

.unity-progress-bar__progress {
    background-color: rgb(59, 130, 246);
    border-radius: 5px;
    margin: 1px;
}

.unity-progress-bar__title {
    color: rgb(236, 238, 243);
    font-size: 12px;
    -unity-font-style: bold;
}

/* ---- 真/假状态徽标：把布尔结果做成一眼可辨的色块，而不只是文字 ---- */
.demo-badge {
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: 5px;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    white-space: normal;
    background-color: rgb(38, 41, 49);
    color: rgb(160, 166, 178);
}

.demo-badge--yes {
    background-color: rgba(34, 130, 80, 0.30);
    border-left-width: 3px;
    border-left-color: rgb(70, 200, 130);
    color: rgb(130, 230, 175);
}

.demo-badge--no {
    background-color: rgba(150, 60, 60, 0.28);
    border-left-width: 3px;
    border-left-color: rgb(220, 110, 110);
    color: rgb(240, 160, 160);
}

/* ---- 滚动条（暗色细条、去掉两端箭头与白色轨道）---- */
.unity-scroller {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

.unity-scroller .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.unity-scroller .unity-base-slider__dragger {
    background-color: rgb(66, 70, 80);
    border-width: 0;
    border-radius: 5px;
    width: 8px;
    margin-left: 1px;
    margin-right: 1px;
}

.unity-scroller .unity-base-slider__dragger:hover {
    background-color: rgb(94, 99, 112);
}

/* ---- 滑动条（Slider / SliderInt，带输入框）：默认深色标签 + 白底输入框都突兀，
       统一成可读标签 + 暗色轨道 + 蓝色手柄 + 暗底输入框。挂 .demo-slider，作用域内改写内部件，
       不波及上面全局滚动条（滚动条的 base-slider 不在 .demo-slider 之下）---- */
.demo-slider {
    margin-top: 4px;
    margin-bottom: 12px;
}

.demo-slider .unity-base-field__label {
    color: rgb(188, 193, 203);
    font-size: 13px;
    min-width: 150px;
}

.demo-slider .unity-base-slider__tracker {
    background-color: rgb(38, 41, 49);
    border-width: 1px;
    border-color: rgb(55, 60, 72);
    border-radius: 3px;
}

.demo-slider .unity-base-slider__dragger {
    background-color: rgb(59, 130, 246);
    border-width: 0;
    border-radius: 6px;
    width: 12px;
}

.demo-slider .unity-base-slider__dragger:hover {
    background-color: rgb(96, 165, 250);
}

/* showInputField 的数字输入框：默认白底 → 暗底 + 可读文字，去掉突兀白块 */
.demo-slider .unity-base-text-field__input {
    background-color: rgb(38, 41, 49);
    border-width: 1px;
    border-color: rgb(55, 60, 72);
    border-radius: 6px;
    color: rgb(220, 224, 232);
}

/* ---- 响应式列表章：绑定的列表项做成淡卡片（文字可读），每行末尾的 ✕ 为幽灵按钮
       （hover 才显红，去掉默认白底的突兀）---- */
.demo-list {
    margin-top: 4px;
    margin-bottom: 4px;
}

.demo-list-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
    padding: 5px 6px 5px 11px;
    background-color: rgb(30, 32, 38);
    border-radius: 6px;
    border-left-width: 3px;
    border-left-color: rgb(60, 78, 110);
}

.demo-list-item {
    flex-grow: 1;
    font-size: 13px;
    color: rgb(206, 211, 221);
}

.demo-list-remove {
    width: 24px;
    height: 24px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(130, 136, 148);
    border-width: 0;
    border-radius: 5px;
    font-size: 13px;
    -unity-font-style: bold;
    transition-duration: 0.08s;
}

.demo-list-remove:hover {
    background-color: rgba(150, 60, 60, 0.28);
    color: rgb(240, 160, 160);
}
