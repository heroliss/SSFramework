/* ============================================================
   SSFramework Demo —— 整体样式主题（暗色 · 简约）
   风格与内容解耦：模块只挂 class，不写内联样式；换肤只改这一份。
   配色：深色底 + 单一蓝色强调（accent = rgb(96,165,250)）。
   ============================================================ */

.demo-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(24, 25, 30);
}

/* 顶部标题条 */
.demo-app-title {
    height: 50px;
    -unity-text-align: middle-left;
    padding-left: 22px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(236, 238, 243);
    background-color: rgb(32, 34, 41);
    border-bottom-width: 1px;
    border-bottom-color: rgb(44, 47, 55);
}

/* 主体：左导航 + 右内容 */
.demo-body {
    flex-grow: 1;
    flex-direction: row;
}

/* ---- 左侧导航 ---- */
.demo-nav {
    width: 238px;
    background-color: rgb(30, 32, 38);
    border-right-width: 1px;
    border-right-color: rgb(44, 47, 55);
    padding-top: 6px;
    padding-bottom: 12px;
}

.demo-nav-category {
    margin-top: 16px;
    margin-bottom: 4px;
    padding-left: 18px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(120, 126, 138);
    letter-spacing: 1px;
}

.demo-nav-item {
    height: 34px;
    margin: 1px 8px;
    padding-left: 12px;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 7px;
    color: rgb(190, 195, 205);
    font-size: 13px;
    transition-duration: 0.08s;
}

.demo-nav-item:hover {
    background-color: rgb(40, 43, 51);
    color: rgb(220, 224, 232);
}

.demo-nav-item--active {
    background-color: rgb(36, 48, 70);
    color: rgb(120, 178, 255);
    -unity-font-style: bold;
}

/* 规划中的章节：导航项弱化显示 */
.demo-nav-item--soon {
    color: rgb(110, 115, 126);
}

/* ---- 右侧内容 ---- */
.demo-content {
    flex-grow: 1;
    padding: 28px 34px;
}

.demo-content-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(236, 238, 243);
    margin-bottom: 6px;
}

.demo-content-summary {
    font-size: 13px;
    color: rgb(150, 156, 168);
    margin-bottom: 20px;
    white-space: normal;
}

.demo-content-body {
    flex-grow: 1;
}

/* ---- 模块内容元素 ---- */
.demo-section-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(120, 178, 255);
    margin-top: 18px;
    margin-bottom: 8px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(44, 47, 55);
}

.demo-note {
    font-size: 13px;
    color: rgb(188, 193, 203);
    margin-bottom: 5px;
    white-space: normal;
}

/* 讲解段落 + 行末源码链接：横排，链接顶对齐贴在文字右侧；放不下时链接整体折到下一行而不是溢出右侧 */
.demo-note-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

/* 手把手步骤：左侧序号徽标 + 右侧步骤说明，把一串操作变成可顺序扫读的有序流程 */
.demo-step {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    margin-top: 9px;
    margin-bottom: 3px;
}

.demo-step-badge {
    flex-shrink: 0;
    min-width: 24px;
    height: 22px;
    margin-right: 10px;
    padding: 0 6px;
    -unity-text-align: middle-center;
    background-color: rgb(36, 48, 70);
    color: rgb(120, 178, 255);
    border-radius: 6px;
    font-size: 13px;
    -unity-font-style: bold;
}

.demo-step-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: rgb(206, 211, 221); /* 比普通 note 略亮：步骤是主干内容 */
    font-size: 13px;
}

/* 次级细节（原理 / 补充）：缩进 + 更小更暗，作为某条主干下的“展开看”内容，与正文拉开层级 */
.demo-subnote {
    font-size: 12px;
    color: rgb(138, 144, 156);
    margin-left: 34px; /* 与 step 文字大致对齐（徽标 min-width 24 + margin 10） */
    margin-bottom: 6px;
    white-space: normal;
}

.demo-tip {
    font-size: 12px;
    color: rgb(245, 205, 130);
    background-color: rgba(120, 90, 30, 0.22);
    border-left-width: 3px;
    border-left-color: rgb(220, 170, 70);
    border-radius: 4px;
    padding: 9px 13px;
    margin-top: 10px;
    margin-bottom: 6px;
    white-space: normal;
}

.demo-value {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(236, 238, 243);
    margin-bottom: 12px;
    white-space: normal;   /* 长状态文本在容器内换行，不再横向溢出屏幕 */
    flex-shrink: 1;        /* 处在 demo-value-row（flex 行）里时也能收缩换行，而非把行撑宽 */
}

/* 值显示 + 行末源码跳转：把“看到的状态”和“喂它的查询 Command”并排 */
.demo-value-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

/* 概念条目：术语 + 说明 的定义列表行（讲解分层职责 / 概念释义） */
.demo-concept {
    flex-direction: row;
    align-items: flex-start; /* 术语换行/说明多行时都从顶部对齐 */
    margin-bottom: 6px;
    padding: 9px 13px;
    background-color: rgb(30, 32, 38);
    border-radius: 6px;
    border-left-width: 3px;
    border-left-color: rgb(60, 78, 110);
}

.demo-concept-term {
    width: 124px;
    flex-shrink: 0;
    margin-right: 10px;
    white-space: normal; /* 长术语在列内换行，不再溢出列宽压到右侧说明上 */
    -unity-font-style: bold;
    color: rgb(120, 178, 255);
    font-size: 13px;
}

.demo-concept-desc {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: rgb(190, 195, 205);
    font-size: 13px;
}

/* 对象池章：左侧控制按钮 + 右侧 UI Toolkit 占位框（UGUI 容器按该框 worldBound 对齐） */
.demo-pool-demo-row {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 4px;
    margin-bottom: 10px;
}

.demo-pool-controls {
    width: 400px; /* 容下最宽的「动作按钮 + 行末查看源码」整行，不让链接溢出压到右侧方块容器上 */
    flex-shrink: 0;
    margin-right: 22px;
}

.demo-pool-anchor {
    flex-grow: 1;
    min-height: 210px;
    background-color: rgba(38, 41, 49, 0.55);
    border-width: 1px;
    border-color: rgb(55, 60, 72);
    border-radius: 6px;
}

/* 动作行：演示按钮 + 紧挨着的源码跳转；放不下时源码链接折到下一行而不是被挤出窗口右侧 */
.demo-action-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 7px;
}

.demo-btn {
    height: 33px;
    min-width: 90px;
    padding: 0 18px;
    background-color: rgb(59, 130, 246);
    color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 7px;
    font-size: 13px;
    -unity-font-style: bold;
    transition-duration: 0.08s;
}

.demo-btn:hover {
    background-color: rgb(37, 99, 235);
}

.demo-btn:active {
    background-color: rgb(29, 78, 216);
}

/* 源码跳转：低调的次级按钮，紧挨动作按钮 */
.demo-code-link {
    min-height: 27px;
    margin-left: 9px;
    padding: 4px 11px;
    background-color: rgb(38, 41, 49);
    color: rgb(150, 168, 198);
    border-width: 1px;
    border-color: rgb(55, 60, 72);
    border-radius: 6px;
    font-size: 11px;
    -unity-font-style: normal;
    white-space: normal;   /* 标签很长时按钮内文字也能换行，配合行级 flex-wrap 双重兜底 */
    flex-shrink: 1;
    transition-duration: 0.08s;
}

.demo-code-link:hover {
    background-color: rgb(36, 48, 70);
    color: rgb(120, 178, 255);
    border-color: rgb(96, 165, 250);
}

/* ---- 下载进度条（默认轨道+填充都偏白，看不出进度；改成暗色轨道 + 蓝色填充 + 可读标题）---- */
.unity-progress-bar {
    margin-top: 2px;
    margin-bottom: 8px;
}

.unity-progress-bar__background {
    background-color: rgb(38, 41, 49);
    border-width: 1px;
    border-color: rgb(55, 60, 72);
    border-radius: 6px;
    min-height: 22px;
}

.unity-progress-bar__progress {
    background-color: rgb(59, 130, 246);
    border-radius: 5px;
    margin: 1px;
}

.unity-progress-bar__title {
    color: rgb(236, 238, 243);
    font-size: 12px;
    -unity-font-style: bold;
}

/* ---- 真/假状态徽标：把布尔结果做成一眼可辨的色块，而不只是文字 ---- */
.demo-badge {
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: 5px;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    white-space: normal;
    background-color: rgb(38, 41, 49);
    color: rgb(160, 166, 178);
}

.demo-badge--yes {
    background-color: rgba(34, 130, 80, 0.30);
    border-left-width: 3px;
    border-left-color: rgb(70, 200, 130);
    color: rgb(130, 230, 175);
}

.demo-badge--no {
    background-color: rgba(150, 60, 60, 0.28);
    border-left-width: 3px;
    border-left-color: rgb(220, 110, 110);
    color: rgb(240, 160, 160);
}

/* ---- 滚动条（暗色细条、去掉两端箭头与白色轨道）---- */
.unity-scroller {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

.unity-scroller .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.unity-scroller .unity-base-slider__dragger {
    background-color: rgb(66, 70, 80);
    border-width: 0;
    border-radius: 5px;
    width: 8px;
    margin-left: 1px;
    margin-right: 1px;
}

.unity-scroller .unity-base-slider__dragger:hover {
    background-color: rgb(94, 99, 112);
}
