  m_Script: {fileID: 11500000, guid: 185f6993d5150494d98da50e26cb1c25, type: 3}
  m_Name: AssetBundleCollectorSetting
  m_EditorClassIdentifier: YooAsset.Editor::YooAsset.Editor.AssetBundleCollectorSetting
  ShowPackageView: 1
  ShowEditorAlias: 0
  UniqueBundleName: 1
  Packages:
  - PackageName: FrameworkSamplesPackage
    PackageDesc: 'Framework samples package: demo + test resources (separated from
      game DefaultPackage; keep or delete with the framework).'
    EnableAddressable: 1
    SupportExtensionless: 1
    LocationToLower: 0
    IncludeAssetGUID: 1
    AutoCollectShaders: 1
    IgnoreRuleName: NormalIgnoreRule
    Groups:
    - GroupName: FrameworkTestGroup
      GroupDesc: "Framework \u6D4B\u8BD5\u56FA\u4EF6\uFF08LittleHouse prefab + \u623F\u5C4B\u6750\u8D28\uFF09\uFF0C\u4F9B
        YooAssetLoadTests \u52A0\u8F7D\u9A8C\u8BC1\u3002"
      AssetTags: framework-test
      ActiveRuleName: EnableGroup
      Collectors:
      - CollectPath: Assets/Game/Framework/Test/Res
        CollectorGUID: 763ef90f7679c824c9aaee5452f76a2a
        CollectorType: 0
        AddressRuleName: AddressByFileName
        PackRuleName: PackDirectory
        FilterRuleName: CollectPrefab
        AssetTags: 
        UserData: 
    - GroupName: FrameworkDemoGroup
      GroupDesc: Framework demo resources loaded by IAssetUtility.
      AssetTags: 
      ActiveRuleName: EnableGroup
      Collectors:
      - CollectPath: Assets/Game/Framework/Res
        CollectorGUID: 205d8c258a640884b959bea4bdfe1191
        CollectorType: 0
        AddressRuleName: AddressByFileName
        PackRuleName: PackDirectory
        FilterRuleName: CollectAll
        AssetTags: framework-demo
        UserData: 
  - PackageName: DefaultPackage
    PackageDesc: Game default package (framework leaves it empty for business assets).
    EnableAddressable: 1
    SupportExtensionless: 1
    LocationToLower: 0
    IncludeAssetGUID: 1
    AutoCollectShaders: 1
    IgnoreRuleName: NormalIgnoreRule
    Groups: []
  - PackageName: CodePackage
