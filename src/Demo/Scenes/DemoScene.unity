    - target: {fileID: 8140010605077647149, guid: 3fe2fbd14ece6d143ba7e03cd8feb9e5, type: 3}
      propertyPath: m_text
      value: "\u3010\u6570\u636E\u7684\u4E8C\u7EF4\u5212\u5206\u3011\n\u6E38\u620F\u91CC\u770B\u4F3C\u4E0D\u540C\u7684\u4E1C\u897F\u5176\u5B9E\u662F\u540C\u4E00\u4E2A\"\u6570\u636E\"\u6982\u5FF5\u7684\u4E0D\u540C\u5207\u9762\u3002\u6309\u4E24\u4E2A\u7EF4\u5EA6\u5206\u7C7B\uFF1A\n\u2022
        \u6709\u5F53\u524D\u503C + \u4E0D\u53EF\u89C2\u5BDF\u2192 \u666E\u901A\u5B57\u6BB5
        (int HP)\n\u2022 \u6709\u5F53\u524D\u503C + \u53EF\u89C2\u5BDF  \u2192 ReactiveProperty<int>
        / RP<int>\n\u2022 \u77AC\u65F6   + \u4E0D\u53EF\u89C2\u5BDF\u2192 \u65E0\u610F\u4E49\uFF08\u4E0D\u5B58\u5728\uFF09\n\u2022
        \u77AC\u65F6   + \u53EF\u89C2\u5BDF  \u2192 \u4E8B\u4EF6 IEvent\n\n\u8FD9\u5F20\u5212\u5206\u76F4\u63A5\u63A8\u5BFC\u51FA\uFF1AEvent
        \u548C Model \u540C\u5C5E\u201C\u6570\u636E\u5C42\u201D\uFF0C\u533A\u522B\u53EA\u5728\u6709\u6CA1\u6709\u5F53\u524D\u503C\u3002\u600E\u4E48\u9009
        RP \u8FD8\u662F Event\uFF1F\u95EE\"\u65B0\u8BA2\u9605\u8005\u9700\u8981\u7ACB\u523B\u77E5\u9053\u5F53\u524D\u72B6\u6001\u5417\uFF1F\"\u2014\u2014\u9700\u8981\u7528
        RP\uFF0C\u4E0D\u9700\u8981\u7528 Event\u3002\n\n\u3010RP<T> \u7C7B\u578B\u65CF\uFF1A\u6765\u6E90\u4E0E\u5206\u5DE5\u3011\nRP<T>
        \u662F\u6846\u67B6\u5BF9 R3 \u5E93\u4E2D\u54CD\u5E94\u5F0F\u5C5E\u6027\u7684\u8584\u5C01\u88C5\u3002\u5B8C\u6574\u7C7B\u578B\u65CF\uFF1A\n\u2022
        Observable<T> \u2014\u2014 \u53EA\u8BFB\u6D41\u62BD\u8C61\uFF08\u65E0 setter\uFF0C\u4E0D\u4FDD\u8BC1\u6709\u5F53\u524D\u503C\uFF09\u3002\n\u2022
        ReactiveProperty<T> \u2014\u2014 \u53EF\u5199\u54CD\u5E94\u5F0F\u72B6\u6001\uFF08Model/System
        \u5185\u90E8\u4F7F\u7528\uFF09\u3002\n\u2022 SerializableReactiveProperty<T>
        \u2014\u2014 R3 \u63D0\u4F9B\u7684\u53EF\u5E8F\u5217\u5316\u7248\u672C\u3002\n\u2022
        RP<T> \u2014\u2014 \u6846\u67B6\u63D0\u4F9B\u7684 SerializableReactiveProperty<T>
        \u522B\u540D\uFF0C\u914D\u4E13\u7528 PropertyDrawer\uFF0C\u6CDB\u578B\u63A8\u65AD\u66F4\u53CB\u597D\u3002Mono
        Model \u9996\u9009\u3002\n\u2022 ReadOnlyReactiveProperty<T> \u2014\u2014
        \u53EA\u8BFB\u54CD\u5E94\u5F0F\u72B6\u6001\u2014\u2014\u63A8\u8350\u4F5C\u4E3A
        Command \u8FD4\u56DE\u7ED9 View \u7684\u72B6\u6001\u6E90\u3002\n\n\u7EE7\u627F\u94FE\uFF1ARP<T>
        \u2190 ReactiveProperty<T> \u2190 ReadOnlyReactiveProperty<T> \u2190 Observable<T>\u3002\u6240\u4EE5
        System \u5B9E\u73B0\u53EF\u4EE5\u76F4\u63A5\u628A RP<T> \u5B57\u6BB5\u5F53
        ReadOnlyReactiveProperty<T> \u66B4\u9732\uFF0C\u96F6\u5206\u914D\u65E0\u8F6C\u6362\u3002\n\n\u3010R3
        \u6574\u5408\uFF1A\u4E00\u5207\u7686 Observable\u3011\n\u4E8B\u4EF6\u3001\u72B6\u6001\u3001UniTask\u3001UnityEvent\u3001C#
        event \u90FD\u80FD\u8F6C Observable<T>\uFF1A\n\u2022 RP<T> / ReactiveProperty<T> 
        \u2192 \u672C\u8EAB\u5C31\u662F Observable\n\u2022 Framework IEvent            
        \u2192 this.OnEvent<TEvent>()\n\u2022 Button.onClick               \u2192
        _btn.OnClickAsObservable()\n\u2022 UniTask<T>                   \u2192 .ToObservable()\n\u2022
        \u6309\u5E27 / \u5B9A\u65F6                  \u2192 Observable.EveryUpdate()
        / Observable.Interval()\n\n\u4E00\u65E6\u8FDB\u5165 Observable\uFF0C\u6240\u6709
        R3 \u64CD\u4F5C\u7B26\uFF08Where / Throttle / CombineLatest / Skip / Buffer\u2026\uFF09\u53EF\u7528\u2014\u2014\u6D3E\u751F\u72B6\u6001\u3001\u8282\u6D41\u3001\u7EC4\u5408\u90FD\u7528\u58F0\u660E\u5F0F\u8868\u8FBE\u5F0F\uFF0C\u6BD4\u624B\u5199\u72B6\u6001\u673A\u7B80\u6D01\u6570\u500D\u3002\n\n\u5F02\u6B65
        Command \u4E5F\u662F\u8FD9\u5957\u4F53\u7CFB\u7684\u5EF6\u4F38\u2014\u2014IAsyncCommand.ExecuteAsync
        \u7684 cancellationToken \u5DF2\u81EA\u52A8\u5408\u5E76 View \u9500\u6BC1
        / Context \u9500\u6BC1 / \u8C03\u7528\u65B9 token\uFF0C\u547D\u4EE4\u5185\u53EA\u770B\u4E00\u4E2A\u53C2\u6570\u3002"
      objectReference: {fileID: 0}
