  m_text: "public class SaveProgressCommand : IAsyncCommand\n{\n    public async
    UniTask ExecuteAsync(ICommandContext ctx, CancellationToken cancellationToken)\n   
    {\n        await _save.WriteAsync(cancellationToken);   // \u552F\u4E00\u8981\u5173\u5FC3\u7684
    token\n    }\n}\n\n// View \u9500\u6BC1\u3001Context Dispose\u3001\u5916\u90E8
    cancel \u4EFB\u4E00\u89E6\u53D1\u90FD\u4F1A\u53D6\u6D88\nawait this.ExecuteCommandAsync(new
    SaveProgressCommand());"
  m_isRightToLeft: 0
