    - target: {fileID: 1233972344328896365, guid: 3fe2fbd14ece6d143ba7e03cd8feb9e5, type: 3}
      propertyPath: m_text
      value: "\u4EAE\u70B9 \u2462\uFF1A\u4E0E Unity \u5F15\u64CE\u6DF1\u5EA6\u878D\u5408"
      objectReference: {fileID: 0}
    - target: {fileID: 3404515385441366866, guid: 3fe2fbd14ece6d143ba7e03cd8feb9e5, type: 3}
      propertyPath: m_text
      value: "Hierarchy \u8868\u8FBE DI \u6811\u3001Inspector \u5B9E\u65F6\u770B
        RP<T>\u3001\u5F15\u64CE\u7EC4\u4EF6\u53EF\u8DE8\u5C42\u2014\u2014Unity \u4E0D\u662F\u7ECA\u811A\u77F3\u800C\u662F\u653E\u5927\u5668\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 4811187592545282864, guid: 3fe2fbd14ece6d143ba7e03cd8feb9e5, type: 3}
      propertyPath: m_text
      value: "\u4F20\u7EDF DI \u5BB9\u5668\u5728 Unity \u91CC\u6C34\u571F\u4E0D\u670D\u2014\u2014\u5B83\u4EEC\u5047\u8BBE\u4F9D\u8D56\u5173\u7CFB\u5728\u4EE3\u7801\u91CC\u58F0\u660E\uFF0C\u4F46\u6E38\u620F\u5F00\u53D1\u4E2D
        GameObject \u5C42\u7EA7\u624D\u662F\u6700\u81EA\u7136\u7684\"\u4F5C\u7528\u57DF\"\u3002\u672C\u6846\u67B6\u53CD\u8FC7\u6765\u62E5\u62B1
        Unity\uFF1A\u4F60\u5DF2\u7ECF\u5728\u62D6 GameObject \u4E86\uFF0C\u90A3\u5C31\u7528\u62D6\u52A8\u7684\u7ED3\u679C\u5F53
        DI \u5173\u7CFB\u3002\n\u8FD9\u8BA9\"\u8C03\u6574\u4F5C\u7528\u57DF\"\u4ECE\u6539\u4EE3\u7801\u964D\u7EA7\u4E3A\u62D6\u52A8\u8282\u70B9\uFF0C\u53EF\u89C6\u5316\u8C03\u8BD5\u4E5F\u53D8\u5F97\u4E0D\u9700\u8981\u4E13\u95E8\u7684\u8C03\u8BD5\u5DE5\u5177\u2014\u2014Inspector
        \u5C31\u662F\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 5527836279579642822, guid: 3fe2fbd14ece6d143ba7e03cd8feb9e5, type: 3}
      propertyPath: m_fontColor.b
