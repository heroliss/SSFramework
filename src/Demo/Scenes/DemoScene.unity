    - target: {fileID: 8140010605077647149, guid: 3fe2fbd14ece6d143ba7e03cd8feb9e5, type: 3}
      propertyPath: m_text
      value: "\u3010\u542F\u52A8\u6D41\u7A0B\u3011\nUnity \u573A\u666F\u542F\u52A8\u540E\u6846\u67B6\u7684\u521D\u59CB\u5316\u662F\u5B8C\u5168\u81EA\u52A8\u7684\uFF0C\u4E1A\u52A1\u65E0\u9700\u624B\u52A8
        Init()\u3002\u9760 [DefaultExecutionOrder] \u6392\u987A\u5E8F\uFF1A\n\n-2000 
        MonoGlobalContext   \u5EFA\u5BB9\u5668 + \u8BBE GameContext.Main + DontDestroyOnLoad\n-1000 
        MonoGameContextBase \u5EFA\u5BB9\u5668 + \u627E\u7236\u7EA7 Context\n-400  
        MonoUtilityBase     \u6CE8\u518C\u5230\u5BB9\u5668\uFF08\u5982 AssetUtility
        \u6700\u65E9\u5C31\u7EEA\uFF09\n-300   MonoModelBase       \u6CE8\u518C\u5230\u5BB9\u5668\uFF08\u5982
        AssetSettingsModel\uFF09\n-200   MonoSystemBase      \u6CE8\u518C\u5230\u5BB9\u5668\uFF08\u5982
        AssetInitSystem \u542F\u52A8\u8D44\u6E90\u521D\u59CB\u5316\uFF09\n-100  
        MonoViewBase        \u6CE8\u5165 [Inject] \u5B57\u6BB5\uFF08\u4E1A\u52A1
        View \u6B64\u65F6\u5DF2\u80FD GetUtility\uFF09\n\n\u4E1A\u52A1\u63A8\u8350\u505A\u6CD5\uFF1A\u5728\u6700\u5916\u5C42
        View \u7684 Awake \u91CC await this.GetUtility<IAssetUtility>().EnsureInitialized()\uFF0C\u7B49\u8D44\u6E90\u5C31\u7EEA\u540E\u518D\u52A0\u8F7D\u5173\u5361
        prefab\u3002\n\n\u3010\u63A8\u8350\u76EE\u5F55\u7ED3\u6784\u3011\nAssets/\n\u251C\u2500\u2500
        Game/\n\u2502   \u251C\u2500\u2500 Framework/              \u2190 \u6846\u67B6\u672C\u4F53\uFF08\u4E0D\u8981\u6539\u6E90\u7801\uFF0C\u8981\u6269\u5C55\u8BF7
        fork \u6216\u52A0 partial\uFF09\n\u2502   \u2502   \u251C\u2500\u2500 Scripts/\n\u2502  
        \u2502   \u251C\u2500\u2500 Demo/\n\u2502   \u2502   \u2514\u2500\u2500 Test/\n\u2502  
        \u2502\n\u2502   \u2514\u2500\u2500 (\u4F60\u7684\u9879\u76EE\u4EE3\u7801)/         
        \u2190 \u4E1A\u52A1\u4EE3\u7801\uFF0C\u6309\u547D\u540D\u7A7A\u95F4\u7EA6\u5B9A\u5206\u76EE\u5F55\n\u2502      
        \u251C\u2500\u2500 Model/              \u2190 MyGame.Model.*\n\u2502      
        \u251C\u2500\u2500 System/             \u2190 MyGame.System.*\n\u2502      
        \u251C\u2500\u2500 Command/            \u2190 MyGame.Command.*\n\u2502      
        \u251C\u2500\u2500 View/               \u2190 MyGame.View.*\n\u2502      
        \u251C\u2500\u2500 Event/              \u2190 MyGame.Event.*\n\u2502      
        \u251C\u2500\u2500 Utility/            \u2190 MyGame.Utility.*\n\u2502      
        \u2514\u2500\u2500 Bootstrap/          \u2190 MonoGlobalContext \u5B50\u7C7B
        + \u573A\u666F\u8D44\u6E90\n\u2502\n\u2514\u2500\u2500 Settings/                  
        \u2190 Unity \u9879\u76EE\u914D\u7F6E\u3001TMP\u3001YooAsset \u7B49\n\n\u5B50\u6A21\u5757\uFF08\u5982
        Boss \u7CFB\u7EDF\uFF09\u5EFA\u8BAE\u5728\u5404\u5C42\u4E0B\u5EFA\u5B50\u76EE\u5F55\uFF1AModel/Boss/\u3001System/Boss/\uFF0C\u6309\u4E1A\u52A1\u5F52\u7C7B\u800C\u975E\u6309\u5C42\u5F52\u7C7B\u3002\n\n\u3010\u5FC5\u8981\u7684\u914D\u7F6E\u6587\u4EF6\u3011\n\u2022
        MonoGlobalContext \u5B50\u7C7B\uFF08\u573A\u666F\u6839\u8282\u70B9\uFF09\u2014\u2014\u9879\u76EE\u552F\u4E00\u6839
