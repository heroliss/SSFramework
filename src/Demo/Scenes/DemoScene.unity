    - target: {fileID: 8140010605077647149, guid: 3fe2fbd14ece6d143ba7e03cd8feb9e5, type: 3}
      propertyPath: m_text
      value: "\u70B9\u51FB\u6309\u94AE \u2192 View \u53D1 Command \u2192 Command
        \u8C03 System \u2192 System \u6539 Model \u2192 R3 \u81EA\u52A8\u901A\u77E5
        View \u66F4\u65B0\u6587\u672C\u3002\n\n\u6CE8\u610F [field: SerializeField]
        public RP<int> Count\u2014\u2014\u8FD9\u662F\u6846\u67B6\u63D0\u4F9B\u7684\u53EF\u5E8F\u5217\u5316\u54CD\u5E94\u5F0F\u5C5E\u6027\uFF08\xA74
        \u8BE6\u89E3\uFF09\uFF0CInspector \u76F4\u63A5\u663E\u793A\u5F53\u524D\u503C\uFF1BSystem
        \u4FEE\u6539 Count.Value\uFF0C\u6240\u6709\u8BA2\u9605\u8005\u7ACB\u5373\u6536\u5230\u901A\u77E5\uFF0CView
        \u4E0D\u9700\u8981\u624B\u52A8\u8C03\u7528 UpdateUI\u3002\n\n\u7559\u610F\u6BCF\u5C42\u7684\u8FB9\u754C\uFF1AView
        \u6CA1\u6709 [Inject] CounterModel\u3001\u6CA1\u6709 GetSystem\u3001\u6CA1\u6709
        SendEvent\u2014\u2014\u5B83\u53EA\u53D1 Command \u548C\u8BA2\u9605 Command
        \u8FD4\u56DE\u7684\u72B6\u6001\u6E90\u3002"
      objectReference: {fileID: 0}
