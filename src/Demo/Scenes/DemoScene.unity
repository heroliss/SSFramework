    - target: {fileID: 6587649294288891171, guid: 3fe2fbd14ece6d143ba7e03cd8feb9e5, type: 3}
      propertyPath: m_Name
      value: Page_02_lifetime-bag
      objectReference: {fileID: 0}
    - target: {fileID: 6587649294288891171, guid: 3fe2fbd14ece6d143ba7e03cd8feb9e5, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8140010605077647149, guid: 3fe2fbd14ece6d143ba7e03cd8feb9e5, type: 3}
      propertyPath: m_text
      value: "\u4F20\u7EDF Unity \u9879\u76EE\u7684\u75DB\u70B9\uFF1AMonoBehaviour
        \u91CC\u5806\u4E00\u5806 private List<IDisposable> _subs\uFF0C\u6BCF\u52A0\u4E00\u4E2A\u8BA2\u9605\u5C31\u8981\u62C5\u5FC3
        OnDestroy \u6F0F\u53CD\u8BA2\u9605\uFF0C\u6BCF\u52A0\u4E00\u4E2A\u8D44\u6E90\u53E5\u67C4\u5C31\u8981\u62C5\u5FC3\u5FD8
        Release\uFF0C\u6BCF\u52A0\u4E00\u4E2A event += handler \u5C31\u8981\u62C5\u5FC3\u5FD8
        -=\u3002\n\n\u6846\u67B6\u628A\"\u4E00\u5207\u6709\u751F\u547D\u5468\u671F\u7684\u4E1C\u897F\"\u7EDF\u4E00\u6536\u7EB3\u5230
        DisposableBag\uFF1A\n\u2022 \u8BA2\u9605\uFF1AFramework Event\u3001R3 Observable\u3001UnityEvent\u3001C#
        event/delegate\n\u2022 \u8D44\u6E90\u53E5\u67C4\uFF1ABag.Load<T>(location)
        \u52A0\u8F7D\u7684 asset\u3001Bag.LoadScene \u52A0\u8F7D\u7684\u573A\u666F\n\u2022
        \u4EFB\u610F IDisposable\uFF1A\u81EA\u5DF1\u521B\u5EFA\u7684\u4EFB\u4F55
        IDisposable \u90FD\u80FD\u6254\u8FDB\u6765\n\nMonoViewBase/MonoModelBase/MonoSystemBase/MonoUtilityBase
        \u5185\u7F6E protected Bag\uFF0COnDestroy \u81EA\u52A8 Dispose\uFF0C\u4E0D\u7528\u5199\u4E00\u884C\u6E05\u7406\u4EE3\u7801\u3002\n\n\u66F4\u77ED\u4F5C\u7528\u57DF\uFF08OnDisable
        / \u56DE\u5408\u671F\u95F4 / \u4E00\u6B21\u6027\u6D41\u7A0B\uFF09\uFF1FBag.CreateChild()
        \u62FF\u5B50\u4F5C\u7528\u57DF\uFF0Cchild \u5355\u72EC Dispose \u4E0D\u5F71\u54CD
        parent\u3001parent.Dispose \u7EA7\u8054\u5230 child\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 8978517784018014901, guid: 3fe2fbd14ece6d143ba7e03cd8feb9e5, type: 3}
      propertyPath: _chapterId
      value: lifetime-bag
      objectReference: {fileID: 0}
