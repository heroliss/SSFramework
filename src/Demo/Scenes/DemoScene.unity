    m_PersistentCalls:
      m_Calls: []
  m_text: "// Model \u76F4\u63A5\u6301\u6709 Rigidbody\uFF0C\u628A\u5B83\u5F53\u4F5C\u7269\u7406\u72B6\u6001\npublic
    class ProjectileModel : MonoModelBase\n{\n    [field: SerializeField] public
    Rigidbody Body  { get; private set; }\n    [field: SerializeField] public RP<float>
    Damage { get; private set; } = new(10f);\n}\n\n// System \u76F4\u63A5\u5199\u5165\u5F15\u64CE\u7EC4\u4EF6\uFF0C\u6548\u679C\u7B49\u4EF7\u4E8E\u6539
    Model \u5B57\u6BB5\npublic class ProjectileSystem : MonoSystemBase\n{\n    [Inject]
    private ProjectileModel _model;\n    public void Launch(Vector3 dir, float speed)\n       
    => _model.Body.AddForce(dir * speed, ForceMode.Impulse);\n}\n\n// View \u4EC0\u4E48\u90FD\u4E0D\u7528\u5199\u2014\u2014Unity
    \u6E32\u67D3\u7BA1\u7EBF\u6BCF\u5E27\u81EA\u52A8\u628A Body \u7684 transform
    \u753B\u51FA\u6765"
