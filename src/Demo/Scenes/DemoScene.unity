  m_text: "// HP \u6216 MaxHP \u4EFB\u4E00\u53D8\u5316\u90FD\u91CD\u7B97 ratio\uFF0CUI
    \u4E0D\u7528\u5173\u5FC3\"\u4EC0\u4E48\u65F6\u5019\u91CD\u7B97\"\nvar ratio =
    model.HP.CombineLatest(\n    model.MaxHP,\n    (hp, max) => max > 0 ? (float)hp
    / max : 0f);\n\nBag.Subscribe(ratio, r => _hpBar.fillAmount = r);"
